# SSH keys — NEVER commit private keys
.ssh_keys/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.so
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Data (large files — keep .gitkeep for directory structure)
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/samples/.gitkeep

# Pipeline data directories (large downloaded / processed files)
data_raw/
data_processed/

# Third-party / vendor datasets pulled locally or on the remote (never commit data)
# (philippdubach options-dataset-hist via Git LFS, applied patches, derived outputs)
data/raw/philippdubach/
data/raw/patches/
data/processed/philippdubach/

# Model weights and large artifacts
*.h5
*.hdf5
*.pt
*.pth
*.ckpt

# Artifacts (outputs — keep .gitkeep for directory structure)
artifacts/figures/*
artifacts/tables/*
artifacts/checkpoints/*
!artifacts/figures/.gitkeep
!artifacts/tables/.gitkeep
!artifacts/checkpoints/.gitkeep

# Phase 2D run artifacts: keep small JSON manifests, drop big prediction CSVs
artifacts/runs/**/*.csv
artifacts/runs/**/*.log
artifacts/runs/**/checkpoints/
# Phase 3A run artifacts: predictions are emitted as parquet; same convention —
# keep small JSON manifests, drop the big prediction files (regenerable on Pod).
artifacts/runs/**/*.parquet

# Phase 2D.4 fitted calibrators (per-run, regenerable from cached val CSVs)
artifacts/calibration/

# Phase 2E.2 latent-capacity diagnostics: keep summary CSVs / JSON / PNGs +
# pc_loadings.npy; drop raw captured latents and run logs (regenerable).
artifacts/diagnostics/**/latents.npy
artifacts/diagnostics/**/run.log

# Phase 2D.9 per-row prediction+decision CSVs (~45 MB each; regenerable from
# scripts/run_decision_layer_eval.py + checkpoints + calibrator). The
# top-level comparison summary, per-pair metrics_summary.csv,
# region_tradability.csv, and PNG figures under results/2D/ stay committed.
results/2D/**/predictions_decisions.csv

# Generated plots and reports (regenerable from pipeline)
/plots/
/reports/
/logs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# AI / coding-assistant config and context files
# EXCEPTION (ADR 0007 — docs/decisions/0007_multi_agent_handoff.md):
# three project-level multi-agent discovery files are deliberately
# COMMITTED so the handoff rules travel with `git clone` and bind every
# agent (Claude, Cursor, …):
#     AGENTS.md, CLAUDE.md, .cursor/rules/000-bootstrap.mdc
# Everything else AI-assistant-related stays local-only (ignored below).
CLAUDE.local.md
.claude/
.claude*
.cursorrules
.cursorignore
.aider*
.continue/
.github/copilot-instructions.md
.codeium/
.windsurf/
.windsurfrules
.tabnine/
GEMINI.md
.gemini/
.agent/
.openhands/
.codex/
.zed/

# .cursor/: ignore all contents EXCEPT the committed bootstrap rule.
.cursor/*
!.cursor/rules/
.cursor/rules/*
!.cursor/rules/000-bootstrap.mdc

# Local-only private operational notes
docs/private/**
!docs/private/.gitkeep

# Local infrastructure readiness / migration notes (operational, never public)
docs/*runpod*readiness*.md
docs/*migration*readiness*.md
docs/**/*runpod*readiness*.md
docs/**/*migration*readiness*.md
docs/**/*runpod*private*.md
docs/**/*infra*private*.md

# Generated repo-tree / local structure snapshots (leak local paths)
docs/agent_bootstrap/repo_tree.txt
docs/agent_bootstrap/repo_tree_summary.md

# Operator's personal working notes — tracked in working tree, never pushed.
# Claude is aware of these files and may read / update them on request,
# but they must stay out of git history.
docs/neural_iv_surface_project_personal_notes.md
docs/neural_iv_surface_research_methodology_narrative.md

# Project-memory review packets / local reports
reports/project_memory/**

# Common local secret material
.env
.env.*
*.pem
*.key
*.p8
*.ppk
.ssh_keys/
