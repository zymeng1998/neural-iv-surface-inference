# SSH keys — NEVER commit private keys
.ssh_keys/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.so
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Data (large files — keep .gitkeep for directory structure)
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/samples/.gitkeep

# Pipeline data directories (large downloaded / processed files)
data_raw/
data_processed/

# Model weights and large artifacts
*.h5
*.hdf5
*.pt
*.pth
*.ckpt

# Artifacts (outputs — keep .gitkeep for directory structure)
artifacts/figures/*
artifacts/tables/*
artifacts/checkpoints/*
!artifacts/figures/.gitkeep
!artifacts/tables/.gitkeep
!artifacts/checkpoints/.gitkeep

# Generated plots and reports (regenerable from pipeline)
/plots/
/reports/
/logs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Local-only private operational notes
docs/private/*.md

# Common local secret material
.env
.env.*
*.pem
*.key
